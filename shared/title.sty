% Authoritative offline trajectory: tools/make-lorenz.py and shared/lorenz-xz.dat.
% Standalone generation replaces this reader with the same in-memory coordinates.
\newcommand{\ConTeXLorenzPath}{\draw[
  draw=NoteGreen!60!black,line width=0.25pt,line cap=round,line join=round
] plot file {tex/lorenz-xz.dat};}
\newcommand{\ConTeXLorenzArtwork}{%
  \begin{tikzpicture}
    % Trajectory scale is independent of equation typography.
    \begin{scope}[x=0.12cm,y=0.12cm]
      \ConTeXLorenzPath
    \end{scope}
    \node[anchor=north east,inner sep=0pt,text=ConTeXInk,font=\small]
      at ([yshift=-10pt]current bounding box.south east)
      {$\begin{gathered}
        \begin{aligned}
          \dot{x}&=\sigma(y-x),\\
          \dot{y}&=x(\rho-z)-y,\\
          \dot{z}&=xy-\beta z
        \end{aligned}\\[3pt]
        \scriptstyle\sigma=10,\quad\rho=28,\quad\beta=\tfrac83
      \end{gathered}$};
  \end{tikzpicture}}
% Legacy artwork API now renders the Lorenz replacement.
\newcommand{\ConTeXSpiralArtwork}{\ConTeXLorenzArtwork}
